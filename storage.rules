rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ehMembro() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/members/$(request.auth.token.email)).data.ativo == true;
    }

    function ehAdmin() {
      return ehMembro()
        && firestore.get(/databases/(default)/documents/members/$(request.auth.token.email)).data.papel == 'admin';
    }

    match /cards/{allPaths=**} {
      allow read: if ehMembro();
      allow write: if ehAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }
  }
}