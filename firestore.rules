rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ehMembro() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.ativo == true;
    }

    function ehAdmin() {
      return ehMembro()
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.papel == 'admin';
    }

    function ehPublicador() {
      return ehMembro()
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.papel == 'publicador';
    }

    match /members/{email} {
      allow read: if ehMembro() && (request.auth.token.email == email || ehAdmin());
      allow create: if ehAdmin();
      // O administrador não se desativa, não muda o próprio papel e não se apaga: o app nunca fica sem administrador.
      allow update: if ehAdmin() && (
        email != request.auth.token.email
        || (request.resource.data.ativo == true && request.resource.data.papel == 'admin')
      );
      allow delete: if ehAdmin() && email != request.auth.token.email;
    }

    match /cards/{cardId} {
      allow read: if ehMembro();
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (
        ehPublicador()
        // só o administrador muda o estado e o ciclo do cartão
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvidas', 'totalCasas', 'atualizadoEm'])
      );

      match /eventos/{eventId} {
        allow read: if ehAdmin();
        allow create: if ehAdmin() || (
          ehPublicador()
          && request.resource.data.tipo == 'rodada'
          && request.resource.data.motivo in ['rodada_aberta', 'rodada_encerrada']
          && request.resource.data.porUid == request.auth.uid
        );
        // O administrador corrige o histórico: muda quando e por quem, ou apaga o registro. Tipo e motivo não mudam.
        allow update: if ehAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['em', 'porNome']);
        allow delete: if ehAdmin();
      }

      match /blocks/{blockId} {
        allow read: if ehMembro();
        allow create, delete: if ehAdmin();
        allow update: if ehAdmin() || (
          ehPublicador()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruas', 'totalCasas', 'faltam', 'rodadaAtual', 'rodadasTotal'])
          && resource.data.ruas.toSet().difference(request.resource.data.ruas.toSet()).size() == 0
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rodadaAtual', 'rodadasTotal'])
            // encerrar: remove rodadaAtual, sem mexer em rodadasTotal
            || (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rodadasTotal'])
              && !('rodadaAtual' in request.resource.data)
            )
            // abrir: rodadaAtual estava vazia e rodadasTotal sobe de 1 em 1
            || (
              resource.data.get('rodadaAtual', null) == null
              && request.resource.data.get('rodadaAtual', null) != null
              && request.resource.data.rodadasTotal == resource.data.get('rodadasTotal', 0) + 1
            )
          )
        );

        match /rodadas/{rodadaId} {
          allow read: if ehMembro();
          allow create: if ehMembro() && request.resource.data.abertaPorUid == request.auth.uid;
          // encerra uma vez só: rodada já encerrada não muda mais
          allow update: if ehMembro()
            && resource.data.get('encerradaPorUid', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encerradaPorUid', 'encerradaPorNome', 'encerradaEm'])
            && request.resource.data.encerradaPorUid == request.auth.uid;
          allow delete: if false;
        }

        match /houses/{houseId} {
          allow read: if ehMembro();
          allow create, update: if ehMembro();
          allow delete: if ehAdmin();

          match /visits/{visitId} {
            allow read: if ehMembro();
            allow create: if ehMembro() && request.resource.data.porUid == request.auth.uid;
            // O administrador só preenche expiraEm (visitas antigas); nada mais muda.
            allow update: if ehAdmin()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiraEm']);
            allow delete: if false;
          }
        }
      }
    }
  }
}